<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="MessageReadCommandSurface">
  <Id>com.outlook.email.link.copy</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Your Company</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName>Copy Email Link</DisplayName>
  <Description>Generate a shareable link for an email</Description>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Mailbox"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <FunctionFile Url="https://yourhost.com/email-link.js"/>
      <ExtensionPoint xsi:type="MessageReadCommandSurface">
        <OfficeMenu id="messageSurface">
          <Control id="copyEmailLinkButton">
            <Label>Copy Email Link</Label>
            <Supertip>
              <Title>Copy Email Link</Title>
              <Description>Generates a link to this email and copies it to the clipboard.</Description>
            </Supertip>
            <Action xsi:type="ExecuteFunction">
              <FunctionName>getSelectedEmail</FunctionName>
            </Action>
          </Control>
        </OfficeMenu>
      </ExtensionPoint>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
</OfficeApp>
